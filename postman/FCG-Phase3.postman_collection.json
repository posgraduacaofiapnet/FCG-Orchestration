{
  "info": {
    "_postman_id": "31062877-5d54-4db4-a3f7-ea4d4b799add",
    "name": "FCG - Fase 3 - Production Hybrid",
    "description": "Fluxo completo da Fase 3 pelo Kong: JWT, cadastro, catálogo, compra, MongoDB, Redis e validação do processamento da Lambda no DynamoDB por endpoint administrativo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gatewayUrl", "value": "http://localhost:8000" },
    { "key": "adminEmail", "value": "admin@fcg.com" },
    { "key": "adminPassword", "value": "AdminSenha@123" },
    { "key": "userName", "value": "Usuario Postman Fase 3" },
    { "key": "userPassword", "value": "Senha@123" },
    { "key": "userEmail", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "gameId", "value": "" },
    { "key": "notificationEventId", "value": "" },
    { "key": "correlationId", "value": "postman-phase3" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'X-Correlation-ID', value: pm.collectionVariables.get('correlationId') });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Health Users pelo Gateway",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{gatewayUrl}}/health/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('UsersAPI saudável', () => pm.response.to.have.status(200));",
              "pm.test('Resposta JSON', () => pm.expect(pm.response.json().status).to.eql('Healthy'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Health Catalog pelo Gateway",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{gatewayUrl}}/health/catalog"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CatalogAPI saudável', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Gateway bloqueia rota sem JWT",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{gatewayUrl}}/api/notifications/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Kong exige JWT', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Registrar usuário",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": "{{gatewayUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const email = `postman-${Date.now()}@fcg.com`;",
              "pm.collectionVariables.set('userEmail', email);",
              "pm.collectionVariables.set('correlationId', `postman-phase3-${Date.now()}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Usuário criado e UserCreated persistido no outbox', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Login usuário",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": "{{gatewayUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login do usuário realizado', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('userToken', body.token);",
              "pm.collectionVariables.set('userId', body.userId);",
              "pm.test('JWT e userId retornados', () => { pm.expect(body.token).to.be.a('string').and.not.empty; pm.expect(body.userId).to.be.a('string').and.not.empty; });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Login administrador",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{gatewayUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login administrativo realizado', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('adminToken', body.token);",
              "pm.test('JWT administrativo retornado', () => pm.expect(body.token).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Criar jogo como administrador",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Cyber FIAP Postman\",\n  \"description\": \"Jogo para validação completa da Fase 3\",\n  \"price\": 99.90\n}"
        },
        "url": "{{gatewayUrl}}/api/games"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Jogo criado', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('gameId', body.id);",
              "pm.test('gameId retornado', () => pm.expect(body.id).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Listar jogos - cache miss",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{gatewayUrl}}/api/games?page=1&pageSize=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Listagem retornada', () => pm.response.to.have.status(200));",
              "pm.test('Jogo criado aparece na listagem', () => pm.expect(pm.response.json().items.map(x => x.id)).to.include(pm.collectionVariables.get('gameId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Listar jogos - cache hit",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{gatewayUrl}}/api/games?page=1&pageSize=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Segunda listagem retornada pelo mesmo contrato', () => pm.response.to.have.status(200));",
              "pm.test('Resposta possui itens', () => pm.expect(pm.response.json().items).to.be.an('array').that.is.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Comprar jogo",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{userToken}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"gameId\": \"{{gameId}}\"\n}"
        },
        "url": "{{gatewayUrl}}/api/library/purchase"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Compra aceita para processamento assíncrono', () => pm.response.to.have.status(202));",
              "pm.collectionVariables.unset('libraryPollAttempt');",
              "pm.collectionVariables.unset('notificationPollAttempt');"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Aguardar jogo na biblioteca",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{userToken}}", "type": "text" }
        ],
        "url": "{{gatewayUrl}}/api/library/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Consulta da biblioteca válida', () => pm.response.to.have.status(200));",
              "const items = pm.response.code === 200 ? pm.response.json() : [];",
              "const found = Array.isArray(items) && items.some(item => item.gameId === pm.collectionVariables.get('gameId'));",
              "const attempt = Number(pm.collectionVariables.get('libraryPollAttempt') || 0);",
              "if (!found && attempt < 20) {",
              "  pm.collectionVariables.set('libraryPollAttempt', attempt + 1);",
              "  setTimeout(() => pm.execution.setNextRequest(pm.info.requestName), 2000);",
              "} else {",
              "  pm.collectionVariables.unset('libraryPollAttempt');",
              "  pm.test('Pagamento aprovado e jogo incluído na biblioteca', () => pm.expect(found).to.eql(true));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Criar avaliação no MongoDB",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{userToken}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Excelente demonstração da Fase 3\"\n}"
        },
        "url": "{{gatewayUrl}}/api/games/{{gameId}}/reviews"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Avaliação persistida no MongoDB', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 - Consultar avaliações no MongoDB",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{gatewayUrl}}/api/games/{{gameId}}/reviews"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Avaliações consultadas', () => pm.response.to.have.status(200));",
              "pm.test('Avaliação criada está presente', () => pm.expect(pm.response.json().some(item => item.comment === 'Excelente demonstração da Fase 3')).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 - Validar Lambda pelo status do DynamoDB",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
        ],
        "url": "{{gatewayUrl}}/api/notifications/status?limit=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Endpoint administrativo respondeu', () => pm.response.to.have.status(200));",
              "const statuses = pm.response.code === 200 ? pm.response.json() : [];",
              "const required = ['OrderPlaced', 'PaymentProcessed'];",
              "const completed = required.every(type => statuses.some(item => item.eventType === type && item.outboxIsSuccessful === true && item.lambdaProcessed === true && item.dynamoStatus === 'Completed'));",
              "const attempt = Number(pm.collectionVariables.get('notificationPollAttempt') || 0);",
              "if (!completed && attempt < 30) {",
              "  pm.collectionVariables.set('notificationPollAttempt', attempt + 1);",
              "  setTimeout(() => pm.execution.setNextRequest(pm.info.requestName), 2000);",
              "} else {",
              "  pm.collectionVariables.unset('notificationPollAttempt');",
              "  pm.test('OrderPlaced e PaymentProcessed foram concluídos pela Lambda', () => pm.expect(completed).to.eql(true));",
              "  const event = statuses.find(item => item.eventType === 'PaymentProcessed' && item.lambdaProcessed === true);",
              "  if (event) pm.collectionVariables.set('notificationEventId', event.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "15 - Consultar evento concluído por ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
        ],
        "url": "{{gatewayUrl}}/api/notifications/status/{{notificationEventId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Evento encontrado', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('DynamoDB comprova execução da Lambda', () => { pm.expect(body.lambdaProcessed).to.eql(true); pm.expect(body.dynamoStatus).to.eql('Completed'); });"
            ]
          }
        }
      ]
    }
  ]
}
