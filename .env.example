# O ambiente local usa LocalStack e nao exige configuracao.
# Para o modo production, copie este modelo para .env na raiz do Orchestration.
# O Docker Compose carrega esse arquivo automaticamente. Nunca o versione.

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1
# SQS_NOTIFICATIONS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT/fcg-notifications-queue
