# O ambiente local usa LocalStack e nao exige configuracao.
# Copie para .env apenas para apontar os workers a uma conta AWS real.
# AWS_SERVICE_URL vazio desabilita o endpoint LocalStack. NAO commite o .env.

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_SERVICE_URL=
# SQS_NOTIFICATIONS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT/fcg-notifications-queue
