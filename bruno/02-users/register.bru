meta {
  name: Register user
  type: http
  seq: 1
}

post {
  url: {{usersUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "{{userName}}",
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

vars:pre-request {
  userName: Joao Silva
  userPassword: Senha@123
}

vars:post-response {
  userEmail: res.body.email
  userId: res.body.id
}

assert {
  res.status: eq 201
}

script:pre-request {
  const email = `tester-${Date.now()}@fcg.com`;
  bru.setVar("userEmail", email);
}

docs {
  Gera um e-mail unico e guarda userEmail/userId para o login.
  Publica UserCreatedEvent (veja logs da NotificationsAPI).
}
