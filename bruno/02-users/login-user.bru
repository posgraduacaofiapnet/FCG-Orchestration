meta {
  name: Login user
  type: http
  seq: 2
}

post {
  url: {{usersUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

vars:pre-request {
  userPassword: Senha@123
}

vars:post-response {
  userToken: res.body.token
  userId: res.body.userId
}

assert {
  res.status: eq 200
}

script:post-response {
  let data = res.getBody();
  if (typeof data === "string") {
    data = JSON.parse(data);
  }
  const token = String((data && (data.token || data.Token)) || "");
  const userId = String((data && (data.userId || data.UserId || data.id)) || "");
  if (token) {
    bru.setVar("userToken", token);
  }
  if (userId) {
    bru.setVar("userId", userId);
  }
}
