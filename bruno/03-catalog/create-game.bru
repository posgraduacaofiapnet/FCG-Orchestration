meta {
  name: Create game (Admin)
  type: http
  seq: 1
}

post {
  url: {{catalogUrl}}/api/games
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  catalogUrl: http://localhost:5102
}

body:json {
  {
    "title": "Cyber FIAP",
    "description": "Jogo demo para o fluxo de compra.",
    "price": 99.90
  }
}

vars:post-response {
  gameId: res.body.id
}

script:post-response {
  let data = res.getBody();
  if (typeof data === "string") {
    data = JSON.parse(data);
  }
  const gameId = String((data && (data.id || data.Id)) || "");
  if (gameId) {
    bru.setVar("gameId", gameId);
  }
}

assert {
  res.status: eq 201
}
