meta {
  name: Create game to delete (Admin)
  type: http
  seq: 5
}

post {
  url: {{catalogUrl}}/api/games
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  catalogUrl: http://localhost:5102
}

body:json {
  {
    "title": "Jogo para Soft Delete",
    "description": "Criado apenas para demonstrar o DELETE.",
    "price": 19.90
  }
}

vars:post-response {
  gameToDeleteId: res.body.id
}

script:post-response {
  let data = res.getBody();
  if (typeof data === "string") {
    data = JSON.parse(data);
  }
  const gameToDeleteId = String((data && (data.id || data.Id)) || "");
  if (gameToDeleteId) {
    bru.setVar("gameToDeleteId", gameToDeleteId);
  }
}

assert {
  res.status: eq 201
}
