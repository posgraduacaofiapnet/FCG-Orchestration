meta {
  name: Purchase game (User)
  type: http
  seq: 7
}

post {
  url: {{catalogUrl}}/api/library/purchase
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{userToken}}
}

body:json {
  {
    "userId": "{{userId}}",
    "gameId": "{{gameId}}"
  }
}

assert {
  res.status: eq 202
}

docs {
  POST /api/library/purchase e o endpoint de compra (nao existe POST /api/orders).
  Publica OrderPlacedEvent no RabbitMQ e OrderPaid na fila SQS (Lambda de e-mail).
  Aguarde ~3s e consulte a biblioteca.
}
