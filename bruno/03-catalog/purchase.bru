meta {
  name: Purchase game (User)
  type: http
  seq: 7
}

post {
  url: {{catalogUrl}}/api/library/purchase
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Do4meiBbzLR2VrbLpecKjoP6fmBzqJ_ZIcEfuGQ8xmc
}

body:json {
  {
    "userId": "{{userId}}",
    "gameId": "{{gameId}}"
  }
}

vars:pre-request {
  catalogUrl: http://localhost:5102
  gameId: f0a4c66b-ae50-4cd4-8c1a-8995c1053ed1
