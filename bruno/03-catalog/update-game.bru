meta {
  name: Update game (Admin)
  type: http
  seq: 4
}

put {
  url: {{catalogUrl}}/api/games/{{gameId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Cyber FIAP - Remasterizado",
    "description": "Jogo demo atualizado para o video.",
    "price": 79.90
  }
}

assert {
  res.status: eq 200
}
